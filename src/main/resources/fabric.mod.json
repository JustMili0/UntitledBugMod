{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "PolloComun (Models, Art)",
    "JustMili (Programming)"
  ],
  "contact": {
    "issues": "",
    "homepage": ""
  },
  "license": "${mod_license}",
  "environment": "*",
  "accessWidener": "${mod_id}.accesswidener",
  "entrypoints": {
    "main": [
      "net.justmili.bugs.BugMod"
    ],
    "client": [
      "net.justmili.bugs.client.FabricClient"
    ],
    "fabric-datagen": [
      "net.justmili.bugs.datagen.DataGenerator"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version_constraint}"
  }
}